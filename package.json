  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "lerna": "^9.0.7",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
