{
  "name": "minerva-requests",
  "version": "0.0.18",
  "description": "JavaScript library for generating request information for interactions with a Minerva server.",
  "keywords": [
    "Berkeley BOP",
    "GO",
    "Gene Ontology",
    "Minerva",
    "Noctua",
    "bbop",
    "client",
    "node",
    "npm",
    "server"
  ],
  "homepage": "https://berkeleybop.org/",
  "bugs": {
    "url": "https://github.com/berkeleybop/bbop-js-monorepo/issues"
  },
  "license": "BSD-3-Clause",
  "author": "SJC <sjcarbon@lbl.gov>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkeleybop/bbop-js-monorepo.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/requests.mjs",
      "require": "./dist/requests.cjs"
    }
  },
  "scripts": {
    "build": "tsdown --format esm --format cjs src/requests.js",
    "prepack": "npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "bbop-core": "^0.0.6",
    "class-expression": "^0.0.13",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "bbop-graph-noctua": "^0.0.35",
    "chai": "^6.2.2"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
